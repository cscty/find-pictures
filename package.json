{
  "name": "find-pictures",
  "displayName": "find-pictures",
  "description": "A high-performance VS Code plugin to find similar/duplicate images in projects, optimize resource management, and reduce project size.",
  "publisher": "cscty",
  "version": "2.0.0",
  "engines": {
    "vscode": "^1.0.0"
  },
  "icon": "images/icon.jpg",
  "repository": "https://github.com/cscty/find-pictures",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "sideEffects": false,
  "contributes": {
    "markdown": {
      "files": [
        {
          "language": "en",
          "path": "README.md"
        },
        {
          "language": "zh-CN",
          "path": "README.zh-CN.md"
        }
      ]
    },
    "commands": [
      {
        "command": "find-pictures.find-pictures",
        "title": "查找相似图片"
      },
      {
        "command": "find-pictures.calculate-image-size",
        "title": "计算项目图片大小"
      },
      {
        "command": "find-pictures.filter-duplicate-images",
        "title": "筛选项目重复图片"
      }
    ],
    "configuration": {
      "title": "find-pictures",
      "properties": {
        "find-pictures.similarity": {
          "type": "number",
          "description": "匹配相似度",
          "default": 1,
          "minimum": 0,
          "maximum": 1
        },
        "find-pictures.includeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "包含目录(includeDirs)",
          "default": [
            "**/"
          ]
        },
        "find-pictures.excludeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "排除目录(excludeDirs)",
          "default": [
            "node_modules"
          ]
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "find-pictures.find-pictures",
          "when": "resourceExtname === .png || resourceExtname === .jpeg || resourceExtname === .jpg",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map"
  },
  "devDependencies": {
    "@types/node": "^20.19.11",
    "@types/vscode": "^1.0.0",
    "electron": "^34.5.8",
    "electron-rebuild": "^3.2.9",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "image-js": "^0.37.0",
    "image-size": "^2.0.2"
  }
}
